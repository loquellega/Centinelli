{
  "id": "mhn-server2",
  "name": "MHN Server 2",
  "server": "https://hectorcruz.com.mx/centinelli/api.php",
  "token": "CAMBIA-ESTE-TOKEN-por-el-de-config.php",
  "interval": 60,
  "command_poll": 10,
  "app": {
    "process": "Arena.exe",
    "launch": [
      "C:/Program Files/Resolume Arena/Arena.exe",
      "D:/MHN/sala.avc"
    ],
    "start_on_boot": false,
    "espera_arranque": 600,
    "autorestart": true,
    "restart_grace": 120,
    "max_restarts_per_hour": 4
  },
  "http_heartbeat": {
    "url": "http://127.0.0.1:8080/api/v1/composition",
    "every": 15,
    "timeout": 4,
    "resolume": true
  },
  "osc": {
    "listen_port": 9300,
    "heartbeat_timeout": 45,
    "heartbeat_is_fps": false,
    "app_host": "127.0.0.1",
    "app_port": 7000
  },
  "sala": {
    "id": "mhn-inmersiva"
  },
  "pantallas": {
    "vigilar": true,
    "cada": 5,
    "restaurar": true,
    "estable": 15,
    "tras_restaurar": "reiniciar_app",
    "max_restauraciones_hora": 6
  },
  "permitir_reinicio_pc": false,
  "screenshot": {
    "enabled": true,
    "every": 300,
    "monitor": 1,
    "width": 480,
    "quality": 60
  }
}